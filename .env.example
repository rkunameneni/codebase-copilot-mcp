# Copy to .env (never commit it) or export in your shell.

# Required only for commands that call Claude: `copilot ask` and `copilot review`.
# Indexing, search, the MCP server, the evals and the whole test suite run without it.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5).
# COPILOT_MODEL=claude-opus-5

# Optional: server-side refusal fallback on the Claude API (default: on). Set to "off" to disable.
# COPILOT_REFUSAL_FALLBACK=on

# Optional: use Voyage AI embeddings instead of the built-in local TF-IDF provider.
# COPILOT_EMBEDDINGS=voyage
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-code-3
